{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:id",
      "has": [{ "type": "host", "value": "link.setupod.com" }],
      "destination": "/link.html"
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "link.setupod.com" }],
      "destination": "/link.html"
    },
    { "source": "/link", "destination": "/link.html" },
    { "source": "/maker", "destination": "/maker.html" },
    { "source": "/studio", "destination": "/maker.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/card/:id", "destination": "/card.html" },
    { "source": "/:id", "destination": "/card.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
