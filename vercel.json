{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "link.setupod.com" }],
      "destination": "/link"
    },
    { "source": "/link", "destination": "/link" },
    { "source": "/maker", "destination": "/maker" },
    { "source": "/studio", "destination": "/maker" },
    { "source": "/kakao", "destination": "/kakao" },
    { "source": "/instagram-teaser", "destination": "/instagram_teaser" },
    { "source": "/instagram-slides", "destination": "/instagram_slides" },
    { "source": "/instagram-3grid", "destination": "/instagram_3grid_banners" },
    { "source": "/scorecard", "destination": "/scorecard" },
    { "source": "/scorecard-maker", "destination": "/scorecard_maker" },
    { "source": "/waitlist", "destination": "/waitlist" },
    { "source": "/waitlist-maker", "destination": "/waitlist_maker" },
    { "source": "/roi-calculator", "destination": "/roi_calculator" },
    { "source": "/privacy", "destination": "/privacy" },
    { "source": "/terms", "destination": "/terms" },
    { "source": "/robots.txt", "destination": "/robots.txt" },
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/sitemap", "destination": "/sitemap.xml" },
    { "source": "/rss.xml", "destination": "/rss.xml" },
    { "source": "/rss", "destination": "/rss.xml" },
    { "source": "/feed.xml", "destination": "/rss.xml" },
    { "source": "/feed", "destination": "/rss.xml" },
    { "source": "/l/:company/:id", "destination": "/link" },
    { "source": "/l/:id", "destination": "/link" },
    { "source": "/c/:company/:id", "destination": "/card" },
    { "source": "/c/:id", "destination": "/card" },
    { "source": "/card/:company/:id", "destination": "/card" },
    { "source": "/card/:id", "destination": "/card" },
    { "source": "/alex", "destination": "/card" },
    { "source": "/setupod", "destination": "/card" },
    { "source": "/nexus/alex", "destination": "/card" },
    { "source": "/nexus", "destination": "/card" }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400, s-maxage=86400" }
      ]
    },
    {
      "source": "/rss.xml",
      "headers": [
        { "key": "Content-Type", "value": "application/rss+xml; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    }
  ]
}
